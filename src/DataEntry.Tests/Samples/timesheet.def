* ─────────────────────────────────────────────────────────────────────────────
* timesheet.def  —  Weekly Employee Timesheet Entry
*
* Demonstrates:
*   NOAPPEND  — fresh file each session
*   LEND=LF   — Unix line endings
*   FG= BG=   — separate foreground/background screen colour attributes
*   Multi-screen form (PageUp / PageDown to switch screens)
*   Escaped literal in FORMAT mask  (99\/99\/9999 — date with slashes)
*   ZeroFill (Z) mask for numeric hours and totals
*   NOT EMPTY rule  — employee ID and week-ending date are required
*   VALUE IS BETWEEN rule  — individual day hours must be 0–24
*   ASSIGN rule  — TOTALS auto-calculated as sum of all seven daily fields
*   MESSAGE clause  — custom error text shown in status bar
* ─────────────────────────────────────────────────────────────────────────────

DATA-SECTION
    FILE timesheets.dat NOAPPEND LRECL=75 LEND=LF

RECORD TIMESHEET
    EMPID   START=1  LEN=6
    FORMAT=999999.
    WEEKEND LEN=10
    FORMAT=99\/99\/9999.
    MON     LEN=5
    FORMAT=ZZ.99.
    TUE     LEN=5
    FORMAT=ZZ.99.
    WED     LEN=5
    FORMAT=ZZ.99.
    THU     LEN=5
    FORMAT=ZZ.99.
    FRI     LEN=5
    FORMAT=ZZ.99.
    SAT     LEN=5
    FORMAT=ZZ.99.
    SUN     LEN=5
    FORMAT=ZZ.99.
    TOTALS  LEN=6
    FORMAT=ZZZ.99.
    JOBCODE LEN=5
    FORMAT=UUUUU.
    APPRVD  LEN=1
    FORMAT=U.
    NOTES   LEN=12
    FORMAT=XXXXXXXXXXXX.

SCREEN-SECTION

* ─────────────────────────────────────────────────────────────────────────────
* Screen 1 — Employee & Job Identification
* ─────────────────────────────────────────────────────────────────────────────
SCREEN TIMESHEET-ENTRY FG=White BG=DarkGreen

    * ── Title banner ────────────────────────────────────────────────────────
    PROMPT "╔══════════════════════════════════════════════════════════════════╗" ROW=1 COL=7
        COLOR=WhiteOnDarkGreen
    PROMPT "║              EMPLOYEE TIMESHEET SYSTEM          (1 of 2)        ║" ROW=2 COL=7
        COLOR=BrightYellowOnDarkGreen
    PROMPT "║                Employee & Job Identification                    ║" ROW=3 COL=7
        COLOR=WhiteOnDarkGreen
    PROMPT "╚══════════════════════════════════════════════════════════════════╝" ROW=4 COL=7
        COLOR=WhiteOnDarkGreen
    PROMPT "  F1=Help  F3=Clear  Ctrl+S=Save  PgDn=Next Screen  F10=Quit  " ROW=5 COL=9
        COLOR=DarkGrayOnDarkGreen

    * ── Employee ID panel ────────────────────────────────────────────────────
    PROMPT "┌─ Employee ─────────────────────────────────────────────────────────┐" ROW=7 COL=6
        COLOR=CyanOnDarkGreen
    PROMPT "Employee ID :" ROW=8 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=8 COL=22 LEN=6 INTO TIMESHEET.EMPID VALIDATE WITH CHECKEMPID
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=9 COL=6
        COLOR=CyanOnDarkGreen

    * ── Week & job panel ─────────────────────────────────────────────────────
    PROMPT "┌─ Week & Job ───────────────────────────────────────────────────────┐" ROW=11 COL=6
        COLOR=CyanOnDarkGreen
    PROMPT "Week Ending :" ROW=12 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=12 COL=22 LEN=10 INTO TIMESHEET.WEEKEND VALIDATE WITH CHECKWEEKEND
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "(MM/DD/YYYY)" ROW=12 COL=32
        COLOR=DarkGrayOnDarkGreen
    PROMPT "Job Code    :" ROW=13 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=13 COL=22 LEN=5 INTO TIMESHEET.JOBCODE VALIDATE WITH CHECKJOBCODE
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=14 COL=6
        COLOR=CyanOnDarkGreen

    PROMPT "  Press PgDn to continue to daily hours entry ▶" ROW=16 COL=16
        COLOR=CyanOnDarkGreen

* ─────────────────────────────────────────────────────────────────────────────
* Screen 2 — Daily Hours Entry
* ─────────────────────────────────────────────────────────────────────────────
SCREEN HOURS-ENTRY FG=White BG=DarkGreen

    * ── Title banner ────────────────────────────────────────────────────────
    PROMPT "╔══════════════════════════════════════════════════════════════════╗" ROW=1 COL=7
        COLOR=WhiteOnDarkGreen
    PROMPT "║              EMPLOYEE TIMESHEET SYSTEM          (2 of 2)        ║" ROW=2 COL=7
        COLOR=BrightYellowOnDarkGreen
    PROMPT "║                   Daily Hours Entry                             ║" ROW=3 COL=7
        COLOR=WhiteOnDarkGreen
    PROMPT "╚══════════════════════════════════════════════════════════════════╝" ROW=4 COL=7
        COLOR=WhiteOnDarkGreen
    PROMPT "  F1=Help  F3=Clear  Ctrl+S=Save  PgUp=Prev Screen  F10=Quit  " ROW=5 COL=9
        COLOR=DarkGrayOnDarkGreen

    * ── Daily hours panel (HH.MM format, e.g. 08.50 = 8 hrs 50 min) ─────────
    PROMPT "┌─ Daily Hours (format: HH.MM) ──────────────────────────────────────┐" ROW=7 COL=6
        COLOR=CyanOnDarkGreen
    PROMPT "Monday    :" ROW=8  COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=8 COL=20 LEN=5 INTO TIMESHEET.MON VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Tuesday   :" ROW=9  COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=9 COL=20 LEN=5 INTO TIMESHEET.TUE VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Wednesday :" ROW=10 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=10 COL=20 LEN=5 INTO TIMESHEET.WED VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Thursday  :" ROW=11 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=11 COL=20 LEN=5 INTO TIMESHEET.THU VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Friday    :" ROW=12 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=12 COL=20 LEN=5 INTO TIMESHEET.FRI VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Saturday  :" ROW=13 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=13 COL=20 LEN=5 INTO TIMESHEET.SAT VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Sunday    :" ROW=14 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=14 COL=20 LEN=5 INTO TIMESHEET.SUN VALIDATE WITH CHECKHOURS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=15 COL=6
        COLOR=CyanOnDarkGreen

    * ── Summary & approval panel ─────────────────────────────────────────────
    PROMPT "┌─ Summary & Approval ───────────────────────────────────────────────┐" ROW=17 COL=6
        COLOR=CyanOnDarkGreen
    PROMPT "Total Hours :" ROW=18 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=18 COL=22 LEN=6 INTO TIMESHEET.TOTALS VALIDATE WITH CALCTOTALS
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Approved    :" ROW=18 COL=31
        COLOR=WhiteOnDarkGreen
    FIELD ROW=18 COL=45 LEN=1 INTO TIMESHEET.APPRVD
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "(Y/N)" ROW=18 COL=48
        COLOR=DarkGrayOnDarkGreen
    PROMPT "Notes       :" ROW=19 COL=8
        COLOR=WhiteOnDarkGreen
    FIELD ROW=19 COL=22 LEN=12 INTO TIMESHEET.NOTES
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=20 COL=6
        COLOR=CyanOnDarkGreen

VALIDATE-SECTION

* Employee ID is required.
VALIDATE CHECKEMPID
    NOT EMPTY MESSAGE "Employee ID is required."

* Week-ending date is required.
VALIDATE CHECKWEEKEND
    NOT EMPTY MESSAGE "Week ending date is required (MM/DD/YYYY)."

* Job code is required.
VALIDATE CHECKJOBCODE
    NOT EMPTY MESSAGE "Job code is required."

* Each day's hours must be between 0 and 24.
* An empty entry (no hours worked) is allowed — the field defaults to 0.
VALIDATE CHECKHOURS
    VALUE IS BETWEEN 0 AND 24 MESSAGE "Hours must be between 0 and 24."

* Auto-calculate total hours as the sum of all seven daily fields.
* The ASSIGN rule fires when the user tabs out of the TOTALS field;
* the returned string replaces the field value automatically.
VALIDATE CALCTOTALS
    TOTALS IS MON + TUE + WED + THU + FRI + SAT + SUN
