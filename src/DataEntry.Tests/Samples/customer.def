* ─────────────────────────────────────────────────────────────────────────────
* customer.def  —  Customer Master Record Entry
* ─────────────────────────────────────────────────────────────────────────────

DATA-SECTION
    FILE customers.dat APPEND LRECL=120 LEND=CRLF

RECORD CUSTOMER
    CUSTID  START=1   LEN=6
    FORMAT=999999.
    LNAME   LEN=20
    FORMAT=XXXXXXXXXXXXXXXXXXXX.
    FNAME   LEN=15
    FORMAT=XXXXXXXXXXXXXXX.
    ADDR1   LEN=25
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXX.
    CITY    LEN=18
    FORMAT=XXXXXXXXXXXXXXXXXX.
    STATE   LEN=2
    FORMAT=UU.
    ZIP     LEN=5
    FORMAT=99999.
    PHONE   LEN=12
    FORMAT=999\-999\-9999.
    EMAIL   LEN=17
    FORMAT=XXXXXXXXXXXXXXXXX.

SCREEN-SECTION
SCREEN CUSTOMER-ENTRY COLOR=WhiteOnBlue

    * ── Title banner ────────────────────────────────────────────────────────
    PROMPT "╔══════════════════════════════════════════════════════════════════╗" ROW=1 COL=6
        COLOR=WhiteOnBlue
    PROMPT "║                   CUSTOMER MASTER FILE                          ║" ROW=2 COL=6
        COLOR=BrightYellowOnBlue
    PROMPT "║                  New / Edit Customer Record                     ║" ROW=3 COL=6
        COLOR=WhiteOnBlue
    PROMPT "╚══════════════════════════════════════════════════════════════════╝" ROW=4 COL=6
        COLOR=WhiteOnBlue
    PROMPT "  F1=Help  F3=Clear  Ctrl+S=Save  Shift+PgUp/Dn=Navigate  F10=Quit  " ROW=5 COL=6
        COLOR=DarkGrayOnBlue

    * ── Identification section ───────────────────────────────────────────────
    PROMPT "┌─ Identification ───────────────────────────────────────────────────┐" ROW=7 COL=5
        COLOR=CyanOnBlue
    PROMPT "Customer ID :" ROW=8  COL=7
        COLOR=WhiteOnBlue
    FIELD ROW=8 COL=21 LEN=6 INTO CUSTOMER.CUSTID
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=9  COL=5
        COLOR=CyanOnBlue

    * ── Name section ─────────────────────────────────────────────────────────
    PROMPT "┌─ Name ─────────────────────────────────────────────────────────────┐" ROW=11 COL=5
        COLOR=CyanOnBlue
    PROMPT "Last Name   :" ROW=12 COL=7
    FIELD ROW=12 COL=21 LEN=20 INTO CUSTOMER.LNAME
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "First Name  :" ROW=12 COL=44
    FIELD ROW=12 COL=58 LEN=15 INTO CUSTOMER.FNAME
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=13 COL=5
        COLOR=CyanOnBlue

    * ── Address section ──────────────────────────────────────────────────────
    PROMPT "┌─ Address ──────────────────────────────────────────────────────────┐" ROW=15 COL=5
        COLOR=CyanOnBlue
    PROMPT "Address     :" ROW=16 COL=7
    FIELD ROW=16 COL=21 LEN=25 INTO CUSTOMER.ADDR1
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "City        :" ROW=17 COL=7
    FIELD ROW=17 COL=21 LEN=18 INTO CUSTOMER.CITY
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "State       :" ROW=18 COL=7
    FIELD ROW=18 COL=21 LEN=2  INTO CUSTOMER.STATE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Zip         :" ROW=18 COL=27
    FIELD ROW=18 COL=41 LEN=5  INTO CUSTOMER.ZIP
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=19 COL=5
        COLOR=CyanOnBlue

    * ── Contact section ──────────────────────────────────────────────────────
    PROMPT "┌─ Contact ──────────────────────────────────────────────────────────┐" ROW=21 COL=5
        COLOR=CyanOnBlue
    PROMPT "Phone       :" ROW=22 COL=7
    FIELD ROW=22 COL=21 LEN=12 INTO CUSTOMER.PHONE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Email       :" ROW=22 COL=37
    FIELD ROW=22 COL=51 LEN=17 INTO CUSTOMER.EMAIL
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└───────────────────────────────────────────────────────────────────┘" ROW=23 COL=5
        COLOR=CyanOnBlue
