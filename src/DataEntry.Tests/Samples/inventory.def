* ─────────────────────────────────────────────────────────────────────────────
* inventory.def  —  Inventory Item Entry Form
*
* Demonstrates:
*   NOT EMPTY rule  — SKU and description are required
*   VALUE IS BETWEEN rule  — quantity and price range checks
*   ASSIGN rule  — reorder level auto-set to 10% of quantity on hand
*   MESSAGE clause  — custom error text shown in status bar
* ─────────────────────────────────────────────────────────────────────────────

DATA-SECTION
    FILE inventory.dat APPEND LRECL=80 LEND=CRLF

RECORD ITEM
    SKU     START=1  LEN=10
    FORMAT=XXXXXXXXXX.
    DESCR   LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    QTY     LEN=6
    FORMAT=ZZZZZZ.
    PRICE   LEN=9
    FORMAT=ZZZZZZ.99.
    LOCATN  LEN=8
    FORMAT=UUUUUUUU.
    ACTIVE  LEN=1
    FORMAT=U.
    REORDER LEN=6
    FORMAT=ZZZZZZ.
    SUPPLR  LEN=10
    FORMAT=XXXXXXXXXX.

SCREEN-SECTION
SCREEN INVENTORY-ENTRY COLOR=WhiteOnDarkBlue

    * ── Title banner ────────────────────────────────────────────────────────
    PROMPT "╔═══════════════════════════════════════════════════════════════════╗" ROW=1 COL=5
        COLOR=WhiteOnDarkBlue
    PROMPT "║              INVENTORY MANAGEMENT SYSTEM                          ║" ROW=2 COL=5
        COLOR=BrightYellowOnDarkBlue
    PROMPT "║                  Stock Item Entry Form                            ║" ROW=3 COL=5
        COLOR=WhiteOnDarkBlue
    PROMPT "╚═══════════════════════════════════════════════════════════════════╝" ROW=4 COL=5
        COLOR=WhiteOnDarkBlue
    PROMPT " F1=Help  F3=Clear  Ctrl+S=Save  Shift+PgUp/Dn=Navigate  F10=Quit " ROW=5 COL=6
        COLOR=DarkGrayOnDarkBlue

    * ── Item identification ───────────────────────────────────────────────────
    PROMPT "┌─ Item Identification ──────────────────────────────────────────────┐" ROW=7 COL=4
        COLOR=CyanOnDarkBlue
    PROMPT "SKU Number  :" ROW=8 COL=6
        COLOR=WhiteOnDarkBlue
    FIELD ROW=8 COL=20 LEN=10 INTO ITEM.SKU VALIDATE WITH CHECKSKU
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Description :" ROW=9 COL=6
        COLOR=WhiteOnDarkBlue
    FIELD ROW=9 COL=20 LEN=30 INTO ITEM.DESCR VALIDATE WITH CHECKDESCR
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└────────────────────────────────────────────────────────────────────┘" ROW=10 COL=4
        COLOR=CyanOnDarkBlue

    * ── Stock levels ─────────────────────────────────────────────────────────
    PROMPT "┌─ Stock Levels ─────────────────────────────────────────────────────┐" ROW=12 COL=4
        COLOR=CyanOnDarkBlue
    PROMPT "Qty On Hand :" ROW=13 COL=6
        COLOR=WhiteOnDarkBlue
    FIELD ROW=13 COL=20 LEN=6 INTO ITEM.QTY VALIDATE WITH CHECKQTY
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Reorder At  :" ROW=13 COL=30
        COLOR=WhiteOnDarkBlue
    FIELD ROW=13 COL=44 LEN=6 INTO ITEM.REORDER VALIDATE WITH CALCREORDER
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Unit Price  :" ROW=14 COL=6
        COLOR=WhiteOnDarkBlue
    FIELD ROW=14 COL=20 LEN=9 INTO ITEM.PRICE VALIDATE WITH CHECKPRICE
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└────────────────────────────────────────────────────────────────────┘" ROW=15 COL=4
        COLOR=CyanOnDarkBlue

    * ── Storage & supplier ───────────────────────────────────────────────────
    PROMPT "┌─ Storage & Supplier ───────────────────────────────────────────────┐" ROW=17 COL=4
        COLOR=CyanOnDarkBlue
    PROMPT "Location    :" ROW=18 COL=6
        COLOR=WhiteOnDarkBlue
    FIELD ROW=18 COL=20 LEN=8 INTO ITEM.LOCATN
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Active (Y/N):" ROW=18 COL=32
        COLOR=WhiteOnDarkBlue
    FIELD ROW=18 COL=46 LEN=1 INTO ITEM.ACTIVE
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "Supplier    :" ROW=19 COL=6
        COLOR=WhiteOnDarkBlue
    FIELD ROW=19 COL=20 LEN=10 INTO ITEM.SUPPLR
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
    PROMPT "└────────────────────────────────────────────────────────────────────┘" ROW=20 COL=4
        COLOR=CyanOnDarkBlue

VALIDATE-SECTION

* SKU must not be blank — every item needs a unique identifier.
VALIDATE CHECKSKU
    NOT EMPTY MESSAGE "SKU number is required."

* Description must not be blank.
VALIDATE CHECKDESCR
    NOT EMPTY MESSAGE "Item description is required."

* Quantity on hand must be 0 or more, up to 999999.
VALIDATE CHECKQTY
    VALUE IS BETWEEN 0 AND 999999 MESSAGE "Quantity must be between 0 and 999999."

* Unit price must be a positive value, up to 9999.99.
VALIDATE CHECKPRICE
    VALUE IS BETWEEN 0 AND 999999 MESSAGE "Price must be between 0.00 and 9999.99."

* Auto-calculate reorder level as 10% of quantity on hand.
* The ASSIGN rule fires when the user tabs out of the REORDER field;
* the returned string replaces the field value automatically.
VALIDATE CALCREORDER
    REORDER IS QTY * 0.1
