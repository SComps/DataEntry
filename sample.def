* sample.def — Customer data entry form example
* Demonstrates all major DSL features

DATA-SECTION
    FILE output.dat APPEND LRECL=130 LEND=CRLF

RECORD CUST
    CNAME   START=1  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CADDR1  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CADDR2  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CCITY   LEN=20
    FORMAT=XXXXXXXXXXXXXXXXXXXX.
    CSTATE  LEN=2
    FORMAT=UU.
    CZIP    LEN=5
    FORMAT=99999.
    CPHONE  LEN=12
    FORMAT=999\-999\-9999.

SCREEN-SECTION
SCREEN CUST-ENTRY COLOR=WhiteOnBlue
    PROMPT "Customer Name:"  ROW=2  COL=2
    FIELD ROW=2 COL=18 LEN=30 INTO CUST.CNAME

    PROMPT "Address Line 1:" ROW=4  COL=2
    FIELD ROW=4 COL=18 LEN=30 INTO CUST.CADDR1

    PROMPT "Address Line 2:" ROW=5  COL=2
    FIELD ROW=5 COL=18 LEN=30 INTO CUST.CADDR2

    PROMPT "City:"           ROW=7  COL=2
    FIELD ROW=7 COL=8  LEN=20 INTO CUST.CCITY

    PROMPT "State:"          ROW=7  COL=30
    FIELD ROW=7 COL=37 LEN=2  INTO CUST.CSTATE

    PROMPT "Zip:"            ROW=7  COL=42
    FIELD ROW=7 COL=47 LEN=5  INTO CUST.CZIP

    PROMPT "Phone:"          ROW=9  COL=2
    FIELD ROW=9 COL=9  LEN=13 INTO CUST.CPHONE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
