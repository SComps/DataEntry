* ─────────────────────────────────────────────────────────────────────────────
* sample.def  —  Simple Customer Entry Form
*
* Demonstrates:
*   NOT EMPTY rule  — name and city are required
*   VALUE IS BETWEEN rule  — zip must be a valid 5-digit range
*   MESSAGE clause  — custom error text shown in status bar
* ─────────────────────────────────────────────────────────────────────────────

DATA-SECTION
    FILE output.dat APPEND LRECL=130 LEND=CRLF

RECORD CUST
    CNAME   START=1  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CADDR1  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CADDR2  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CCITY   LEN=20
    FORMAT=XXXXXXXXXXXXXXXXXXXX.
    CSTATE  LEN=2
    FORMAT=UU.
    CZIP    LEN=5
    FORMAT=99999.
    CPHONE  LEN=12
    FORMAT=999\-999\-9999.

SCREEN-SECTION
SCREEN CUST-ENTRY COLOR=WhiteOnBlue

    * ── Title banner ────────────────────────────────────────────────
    PROMPT "╔══════════════════════════════════════════════════════╗" ROW=1 COL=13
        COLOR=WhiteOnBlue
    PROMPT "║          CUSTOMER ENTRY — SAMPLE FORM                ║" ROW=2 COL=13
        COLOR=YellowOnBlue
    PROMPT "╚══════════════════════════════════════════════════════╝" ROW=3 COL=13
        COLOR=WhiteOnBlue
    PROMPT "F1=Help  F3=Clear  Ctrl+S=Save  Shift+PgUp/Dn=Navigate  F10=Quit" ROW=4 COL=7
        COLOR=DarkGrayOnBlue

    * ── Section divider ─────────────────────────────────────────────
    PROMPT "┌─ Contact Details ───────────────────────────────────────────────────────┐" ROW=6 COL=2
        COLOR=CyanOnBlue

    * ── Fields ──────────────────────────────────────────────────────
    PROMPT "Name   :" ROW=7  COL=4
    FIELD ROW=7 COL=14 LEN=30 INTO CUST.CNAME VALIDATE WITH CHECKNAME
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Address:" ROW=9  COL=4
    FIELD ROW=9 COL=14 LEN=30 INTO CUST.CADDR1
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "        " ROW=10 COL=4
    FIELD ROW=10 COL=14 LEN=30 INTO CUST.CADDR2
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "City   :" ROW=12 COL=4
    FIELD ROW=12 COL=14 LEN=20 INTO CUST.CCITY VALIDATE WITH CHECKCITY
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "State  :" ROW=12 COL=37
    FIELD ROW=12 COL=47 LEN=2  INTO CUST.CSTATE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Zip    :" ROW=12 COL=52
    FIELD ROW=12 COL=62 LEN=5  INTO CUST.CZIP VALIDATE WITH CHECKZIP
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Phone  :" ROW=14 COL=4
    FIELD ROW=14 COL=14 LEN=12 INTO CUST.CPHONE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "└─────────────────────────────────────────────────────────────────────────┘" ROW=16 COL=2
        COLOR=CyanOnBlue

VALIDATE-SECTION

* Name must not be left blank.
VALIDATE CHECKNAME
    NOT EMPTY MESSAGE "Name is required."

* City must not be left blank.
VALIDATE CHECKCITY
    NOT EMPTY MESSAGE "City is required."

* Zip must be a 5-digit US postal code (00001 – 99999).
VALIDATE CHECKZIP
    NOT EMPTY MESSAGE "Zip code is required."
    VALUE IS BETWEEN 1 AND 99999 MESSAGE "Zip must be a number between 00001 and 99999."
