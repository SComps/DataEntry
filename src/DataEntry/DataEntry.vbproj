<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DataEntry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- AOT publish properties — only active when PublishAot=true (i.e. during ./publish.sh) -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Suppress trim warnings from Terminal.Gui's reflection-based config system -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataEntry.Core\DataEntry.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DataEntry.Tests\Samples\*.def" CopyToPublishDirectory="PreserveNewest" Link="Samples\%(Filename)%(Extension)" />
    <None Include="..\..\sample.def" CopyToPublishDirectory="PreserveNewest" Link="Samples\sample.def" Condition="Exists('..\..\sample.def')" />
  </ItemGroup>

</Project>
