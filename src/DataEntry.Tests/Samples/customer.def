* customer.def
* Customer master record — name, address, contact details.
* Demonstrates multi-field layout, phone/zip masking, and state upper-case.

DATA-SECTION
    FILE customers.dat APPEND LRECL=120 LEND=CRLF

RECORD CUSTOMER
    CUSTID  START=1   LEN=6
    FORMAT=999999.
    LNAME   LEN=20
    FORMAT=XXXXXXXXXXXXXXXXXXXX.
    FNAME   LEN=15
    FORMAT=XXXXXXXXXXXXXXX.
    ADDR1   LEN=25
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXX.
    CITY    LEN=18
    FORMAT=XXXXXXXXXXXXXXXXXX.
    STATE   LEN=2
    FORMAT=UU.
    ZIP     LEN=5
    FORMAT=99999.
    PHONE   LEN=12
    FORMAT=999\-999\-9999.
    EMAIL   LEN=17
    FORMAT=XXXXXXXXXXXXXXXXX.

SCREEN-SECTION
SCREEN CUSTOMER-ENTRY COLOR=WhiteOnBlue
    PROMPT "Customer ID:"   ROW=2  COL=2
    FIELD ROW=2 COL=15 LEN=6 INTO CUSTOMER.CUSTID
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Last Name:"     ROW=4  COL=2
    FIELD ROW=4 COL=13 LEN=20 INTO CUSTOMER.LNAME

    PROMPT "First Name:"    ROW=4  COL=36
    FIELD ROW=4 COL=48 LEN=15 INTO CUSTOMER.FNAME

    PROMPT "Address:"       ROW=6  COL=2
    FIELD ROW=6 COL=11 LEN=25 INTO CUSTOMER.ADDR1

    PROMPT "City:"          ROW=8  COL=2
    FIELD ROW=8 COL=8  LEN=18 INTO CUSTOMER.CITY

    PROMPT "State:"         ROW=8  COL=29
    FIELD ROW=8 COL=36 LEN=2  INTO CUSTOMER.STATE

    PROMPT "Zip:"           ROW=8  COL=42
    FIELD ROW=8 COL=47 LEN=5  INTO CUSTOMER.ZIP

    PROMPT "Phone:"         ROW=10 COL=2
    FIELD ROW=10 COL=9 LEN=12 INTO CUSTOMER.PHONE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Email:"         ROW=10 COL=26
    FIELD ROW=10 COL=33 LEN=17 INTO CUSTOMER.EMAIL
