* timesheet.def
* Weekly employee timesheet — employee ID, week ending date, and daily hours.
* Demonstrates numeric fields, zero-fill, and multiple screens.

DATA-SECTION
    FILE timesheets.dat NOAPPEND LRECL=65 LEND=LF

RECORD TIMESHEET
    EMPID   START=1  LEN=6
    FORMAT=999999.
    WEEKEND LEN=8
    FORMAT=99\/99\/9999.
    MON     LEN=4
    FORMAT=ZZ.99.
    TUE     LEN=4
    FORMAT=ZZ.99.
    WED     LEN=4
    FORMAT=ZZ.99.
    THU     LEN=4
    FORMAT=ZZ.99.
    FRI     LEN=4
    FORMAT=ZZ.99.
    SAT     LEN=4
    FORMAT=ZZ.99.
    SUN     LEN=4
    FORMAT=ZZ.99.
    TOTALS  LEN=5
    FORMAT=ZZZ.99.
    JOBCODE LEN=5
    FORMAT=UUUUU.
    APPRVD  LEN=1
    FORMAT=U.
    NOTES   LEN=12
    FORMAT=XXXXXXXXXXXX.

SCREEN-SECTION
SCREEN TIMESHEET-ENTRY FG=White BG=DarkGreen
    PROMPT "Employee ID:"  ROW=2  COL=2
    FIELD ROW=2 COL=15 LEN=6 INTO TIMESHEET.EMPID
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Week Ending:"  ROW=2  COL=24
    FIELD ROW=2 COL=37 LEN=8 INTO TIMESHEET.WEEKEND
        NORMAL=WhiteOnDarkGreen FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Job Code:"     ROW=2  COL=48
    FIELD ROW=2 COL=58 LEN=5 INTO TIMESHEET.JOBCODE

SCREEN HOURS-ENTRY FG=White BG=DarkGreen
    PROMPT "Monday:"    ROW=4  COL=2
    FIELD ROW=4 COL=10 LEN=4 INTO TIMESHEET.MON

    PROMPT "Tuesday:"   ROW=5  COL=2
    FIELD ROW=5 COL=11 LEN=4 INTO TIMESHEET.TUE

    PROMPT "Wednesday:" ROW=6  COL=2
    FIELD ROW=6 COL=13 LEN=4 INTO TIMESHEET.WED

    PROMPT "Thursday:"  ROW=7  COL=2
    FIELD ROW=7 COL=12 LEN=4 INTO TIMESHEET.THU

    PROMPT "Friday:"    ROW=8  COL=2
    FIELD ROW=8 COL=10 LEN=4 INTO TIMESHEET.FRI

    PROMPT "Saturday:"  ROW=9  COL=2
    FIELD ROW=9 COL=12 LEN=4 INTO TIMESHEET.SAT

    PROMPT "Sunday:"    ROW=10 COL=2
    FIELD ROW=10 COL=10 LEN=4 INTO TIMESHEET.SUN

    PROMPT "Total:"     ROW=12 COL=2
    FIELD ROW=12 COL=9  LEN=5 INTO TIMESHEET.TOTALS

    PROMPT "Approved:"  ROW=12 COL=17
    FIELD ROW=12 COL=27 LEN=1 INTO TIMESHEET.APPRVD

    PROMPT "Notes:"     ROW=14 COL=2
    FIELD ROW=14 COL=9  LEN=12 INTO TIMESHEET.NOTES
