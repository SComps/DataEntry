* sample.def — Customer data entry form example
* Demonstrates all major DSL features

DATA-SECTION
    FILE output.dat APPEND LRECL=130 LEND=CRLF

RECORD CUST
    CNAME   START=1  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CADDR1  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CADDR2  LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    CCITY   LEN=20
    FORMAT=XXXXXXXXXXXXXXXXXXXX.
    CSTATE  LEN=2
    FORMAT=UU.
    CZIP    LEN=5
    FORMAT=99999.
    CPHONE  LEN=12
    FORMAT=999\-999\-9999.

SCREEN-SECTION
SCREEN CUST-ENTRY COLOR=WhiteOnBlue
    FIELD "Customer Name"  ROW=2  COL=2  LEN=30  INTO CUST.CNAME
    FIELD "Address Line 1" ROW=4  COL=2  LEN=30  INTO CUST.CADDR1
    FIELD "Address Line 2" ROW=5  COL=2  LEN=30  INTO CUST.CADDR2
    FIELD "City"           ROW=7  COL=2  LEN=20  INTO CUST.CCITY
    FIELD "State"          ROW=7  COL=30 LEN=2   INTO CUST.CSTATE
    FIELD "Zip"            ROW=7  COL=42 LEN=5   INTO CUST.CZIP
    FIELD "Phone"          ROW=9  COL=2  LEN=13  INTO CUST.CPHONE
        NORMAL=WhiteOnBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed
