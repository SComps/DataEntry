* inventory.def
* Inventory item entry — SKU, description, quantity, price, location.
* Demonstrates VALIDATE WITH and numeric formatting with zero-fill.

DATA-SECTION
    FILE inventory.dat APPEND LRECL=80 LEND=CRLF

RECORD ITEM
    SKU     START=1  LEN=10
    FORMAT=XXXXXXXXXX.
    DESCR   LEN=30
    FORMAT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.
    QTY     LEN=6
    FORMAT=ZZZZZZ.
    PRICE   LEN=9
    FORMAT=ZZZZZZ.99.
    LOCATN  LEN=8
    FORMAT=UUUUUUUU.
    ACTIVE  LEN=1
    FORMAT=U.
    REORDER LEN=6
    FORMAT=ZZZZZZ.
    SUPPLR  LEN=10
    FORMAT=XXXXXXXXXX.

SCREEN-SECTION
SCREEN INVENTORY-ENTRY COLOR=WhiteOnDarkBlue
    PROMPT "SKU:"         ROW=2  COL=2
    FIELD ROW=2 COL=7 LEN=10 INTO ITEM.SKU VALIDATE WITH CHECKSKU
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Description:" ROW=4  COL=2
    FIELD ROW=4 COL=15 LEN=30 INTO ITEM.DESCR

    PROMPT "Qty On Hand:" ROW=6  COL=2
    FIELD ROW=6 COL=15 LEN=6 INTO ITEM.QTY VALIDATE WITH CHECKQTY
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Unit Price:"  ROW=6  COL=25
    FIELD ROW=6 COL=37 LEN=9 INTO ITEM.PRICE VALIDATE WITH CHECKPRICE
        NORMAL=WhiteOnDarkBlue FOCUS=BlackOnCyan ERROR=WhiteOnRed

    PROMPT "Location:"    ROW=8  COL=2
    FIELD ROW=8 COL=12 LEN=8 INTO ITEM.LOCATN

    PROMPT "Active:"      ROW=8  COL=24
    FIELD ROW=8 COL=32 LEN=1 INTO ITEM.ACTIVE

    PROMPT "Reorder At:"  ROW=10 COL=2
    FIELD ROW=10 COL=14 LEN=6 INTO ITEM.REORDER

    PROMPT "Supplier:"    ROW=10 COL=24
    FIELD ROW=10 COL=34 LEN=10 INTO ITEM.SUPPLR
